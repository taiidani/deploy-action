// The real machine hostname (mounted from /etc/hostname). constants.hostname
// returns the container's own hostname (e.g. "alloy-vo1c"), not the machine's.
local.file "hostname" {
	filename = "/etc/host_hostname"
}

// Discover all containers on this host via the Docker socket.
discovery.docker "containers" {
	host = "unix:///var/run/docker.sock"
}

// Turn the Docker container name (e.g. "/groceries-app-1") into a clean
// "container" label (e.g. "groceries-app-1").
discovery.relabel "containers" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}
}

// Tail each discovered container's logs and forward them to Loki.
loki.source.docker "containers" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.containers.output
	forward_to = [loki.write.default.receiver]
}

// Ship logs to the central Loki on terra and Grafana Cloud. Reading the host's
// hostname keeps this file identical on every host while still labeling logs
// by their source machine.
loki.write "default" {
	endpoint {
		url = "http://monitoring-loki.internal:3100/loki/api/v1/push"
	}

	// Grafana Cloud (dual-write during migration).
	endpoint {
		url = sys.env("GRAFANA_CLOUD_LOKI_URL")

		basic_auth {
			username = sys.env("GRAFANA_CLOUD_LOKI_USER")
			password = sys.env("GRAFANA_CLOUD_TOKEN")
		}
	}

	external_labels = {
		host = string.trim_space(local.file.hostname.content),
	}
}

// Receive OTLP metrics and traces from local applications over gRPC (4317) and HTTP (4318),
// the OpenTelemetry defaults. Apps on this host point their exporter at
// localhost and Alloy handles shipping to the central backend.
otelcol.receiver.otlp "default" {
	grpc {
		endpoint = "0.0.0.0:4317"
	}

	http {
		endpoint = "0.0.0.0:4318"
	}

	output {
		traces = [otelcol.processor.attributes.default.input]
		metrics = [otelcol.exporter.prometheus.default.input]
	}
}

// Stamp every span with the source machine so traces can be correlated with
// logs (which carry the matching "host" label). Mirrors loki.write above.
otelcol.processor.attributes "default" {
	action {
		key    = "host.name"
		value  = string.trim_space(local.file.hostname.content)
		action = "upsert"
	}

	output {
		traces = [otelcol.processor.filter.drop_ping.input]
	}
}

// Drop healthcheck "ping" spans; they are noise and don't need observability.
otelcol.processor.filter "drop_ping" {
	error_mode = "ignore"

	traces {
		span = [
			`IsMatch(name, "(?i)^ping$")`,
		]
	}

	output {
		traces = [otelcol.processor.batch.default.input]
	}
}

// Batch spans before shipping to cut network overhead.
otelcol.processor.batch "default" {
	output {
		traces = [
			otelcol.exporter.otlp.tempo.input,
			otelcol.exporter.otlp.grafana_cloud.input,
		]
	}
}

// Grafana Cloud Tempo (dual-write during migration). The endpoint must be
// host:port with no scheme, e.g. "tempo-prod-XX-prod-REGION.grafana.net:443".
otelcol.auth.basic "grafana_cloud" {
	username = sys.env("GRAFANA_CLOUD_TEMPO_USER")
	password = sys.env("GRAFANA_CLOUD_TOKEN")
}

otelcol.exporter.otlp "grafana_cloud" {
	client {
		endpoint = sys.env("GRAFANA_CLOUD_TEMPO_URL")
		auth     = otelcol.auth.basic.grafana_cloud.handler
	}
}

// Ship traces to the central Tempo on terra. Its OTLP gRPC receiver is
// published on host port 4417 there (4317 is taken by that host's own Alloy).
otelcol.exporter.otlp "tempo" {
	client {
		endpoint = "monitoring-tempo.internal:4317"

		tls {
			insecure = true
		}
	}
}

// Convert OTLP metrics to Prometheus format
otelcol.exporter.prometheus "default" {
	forward_to = [prometheus.remote_write.default.receiver]
}

// Ship to your central Prometheus
prometheus.remote_write "default" {
	endpoint {
		url = "http://monitoring-prometheus.internal:9090/api/v1/write"
	}
}
